# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# NO KEYS ARE KNOWN OR REQUIRED YET. No source has been audited, so no
# authentication requirement has been confirmed. These names are placeholders
# and will be replaced once API_REQUIREMENTS.md section 2 has VERIFIED rows.

# KARAMYOGI_CONTACT_EMAIL=
# KARAMYOGI_USER_AGENT=KaramYogiAI-discovery/0.1 (+contact: )

# Example placeholder only - endpoint and key requirement both UNKNOWN:
# SRC_010_API_KEY=

# --- iGOT Karmayogi ---------------------------------------------------------
# "mock" (default) uses clients/mock_igot_client.py with MOCK fixtures.
# "live" is refused: no documented API and no authorized access exist yet.
# See IGOT_ACCESS_STATUS.md and API_REQUIREMENTS.md section 6.4.
IGOT_CLIENT_MODE=mock
# Placeholders only. Values must come from an official Karmayogi Bharat
# process and must never be committed.
# IGOT_API_BASE_URL=
# IGOT_API_KEY=

# --- Application backend (Phase 2) -------------------------------------------
# local | ci | staging | pilot | production
APP_ENV=local
LOG_LEVEL=INFO
# Local database from deploy/docker-compose.yml (pgvector/pgvector:pg17 on host port 5433).
# Choose your own password; never commit real values.
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=platform
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg://platform:change-me-local-only@127.0.0.1:5433/platform
# Used only by the backend test suite; tests create and drop schema objects here.
TEST_DATABASE_URL=postgresql+psycopg://platform:change-me-local-only@127.0.0.1:5433/platform_test

# --- Sessions (vertical slice 1) ---------------------------------------------
# At least 32 random characters, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-value-at-least-32-chars
# false is allowed only in local/ci (plain http://localhost). Must stay true elsewhere.
SESSION_COOKIE_SECURE=false
# Password given to the synthetic demo users by `python -m app.seed --demo-users` (local/ci only, min 12 chars).
DEMO_USER_PASSWORD=change-me-demo-password

# --- Accounts (Phase 4A) -------------------------------------------------------
# Learner self-registration (learner role only). Unset = on in local/ci, off elsewhere; true is refused outside local/ci.
# LEARNER_SELF_REGISTRATION_ENABLED=
# Lifetime of administrator-issued account-setup / password-reset links, in hours.
# PASSWORD_TOKEN_TTL_HOURS=24
